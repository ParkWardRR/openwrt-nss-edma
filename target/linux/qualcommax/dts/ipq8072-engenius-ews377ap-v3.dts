// SPDX-License-Identifier: GPL-2.0-or-later OR BSD-2-Clause
/*
 * EnGenius EWS377AP v3  (Qualcomm IPQ8072A, board "ap-hk07")
 *
 * Base structure derived from ipq8072-eap660hd-v1.dts (TP-Link EAP660 HD v1),
 * the closest in-tree IPQ8072 4x4 AP. GPIO/LED/PHY values below marked
 * "CONFIRMED (OEM hk07 DTB)" were transcribed from the vendor device tree
 * fdt@hk07 (default config) extracted from stock firmware EWS377-FIT 1.1.30
 * — model "Qualcomm IPQ807x/AP-HK07". Values still marked TODO(extract)
 * need the running unit / UART. Not yet flash-validated.
 */

/dts-v1/;

#include "ipq8074.dtsi"
#include "ipq8074-nss.dtsi"
#include "ipq8074-hk-cpu.dtsi"
#include "ipq8074-ess.dtsi"
#include <dt-bindings/leds/common.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "EnGenius EWS377AP v3";
	compatible = "engenius,ews377ap-v3", "qcom,ipq8074";

	aliases {
		serial0 = &blsp1_uart5;
		led-boot = &led_blue;
		led-failsafe = &led_red;
		led-running = &led_blue;
		led-upgrade = &led_green;
	};

	chosen {
		stdout-path = "serial0,115200n8";
		bootargs-append = " root=/dev/ubiblock0_1";
	};

	keys {
		compatible = "gpio-keys";

		/* CONFIRMED (OEM hk07 DTB): reset on GPIO52, active-low */
		reset {
			label = "reset";
			gpios = <&tlmm 52 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	/*
	 * CONFIRMED (OEM hk07 DTB): single RGB status LED, active-high, on
	 * GPIO54 (R) / GPIO55 (G) / GPIO56 (B). Vendor labels: led_r/led_g/led_b.
	 */
	leds {
		compatible = "gpio-leds";

		led_red: led-red {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_RED>;
			gpios = <&tlmm 54 GPIO_ACTIVE_HIGH>;
		};

		led_green: led-green {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 55 GPIO_ACTIVE_HIGH>;
		};

		led_blue: led-blue {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&tlmm 56 GPIO_ACTIVE_HIGH>;
		};
	};
};

&blsp1_uart5 {
	status = "okay";
};

&tlmm {
	mdio_pins: mdio-pins {
		mdc {
			pins = "gpio68";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio {
			pins = "gpio69";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

&mdio {
	status = "okay";
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	/*
	 * CONFIRMED (OEM hk07 DTB): phy-reset-gpio = GPIO43 (active-high) +
	 * GPIO44 (active-low). QSDK drives both; mainline resets the bus once,
	 * so assert the primary line. TODO(validate): confirm on hardware that
	 * a single reset on GPIO43 brings all PHYs up.
	 */
	reset-gpios = <&tlmm 43 GPIO_ACTIVE_HIGH>;

	/*
	 * CONFIRMED (OEM hk07 DTB): MDIO bus has internal PHYs at addr 0-4
	 * (gigabit) and the uplink PHY at addr 0x1c (28) — the 2.5G QCA8081,
	 * ESS port 6 / WAN in the reference design. As a managed AP the EWS377
	 * uses this 2.5G port as its single PoE uplink.
	 * TODO(validate): whether any gigabit port (phy 0-4) is physically
	 * populated on the EWS377AP v3 enclosure.
	 */
	qca8081_28: ethernet-phy@28 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <28>;
	};
};

&uniphy1 {
	status = "okay";
};

&switch {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			ethernet = <&edma>;
			phy-mode = "internal";

			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};

		/* TODO(extract): confirm ESS port index + link speed for the uplink */
		swport5: port@5 {
			reg = <5>;
			label = "lan";
			phy-handle = <&qca8081_28>;
			phy-mode = "2500base-x";
			pcs-handle = <&uniphy1 0>;
		};
	};
};

&edma {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	status = "okay";

	nand@0 {
		reg = <0>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		/*
		 * OEM firmware is QSDK OpenWrt and defines the partition table in
		 * SMEM, so the layout (DEVCFG/APPSBLENV/APPSBL/cert/ART/rootfs A/B)
		 * is read automatically here — no hand-written offsets needed.
		 */
		partitions {
			compatible = "qcom,smem-part";
		};
	};
};

&wifi {
	status = "okay";
	/*
	 * TODO(extract): this string must match the board-data variant inside
	 * the board-2.bin supplied by package ipq-wifi-engenius_ews377ap-v3,
	 * which itself must be built from the OEM /lib/firmware/IPQ8074 BDF.
	 */
	qcom,ath11k-calibration-variant = "EnGenius-EWS377AP-v3";
};
