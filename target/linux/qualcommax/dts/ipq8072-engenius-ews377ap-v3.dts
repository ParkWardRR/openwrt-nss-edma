// SPDX-License-Identifier: GPL-2.0-or-later OR BSD-2-Clause
/*
 * EnGenius EWS377AP v3  (Qualcomm IPQ8072A, board "ap-hk07")
 *
 * Base structure derived from ipq8072-eap660hd-v1.dts (TP-Link EAP660 HD v1),
 * the closest in-tree IPQ8072 4x4 AP. GPIO/LED/PHY values below marked
 * "CONFIRMED (OEM hk07 DTB)" were transcribed from the vendor device tree
 * fdt@hk07 (default config) extracted from stock firmware EWS377-FIT 1.1.30
 * — model "Qualcomm IPQ807x/AP-HK07". Values still marked TODO(extract)
 * need the running unit / UART. Not yet flash-validated.
 */

/dts-v1/;

#include "ipq8074.dtsi"
#include "ipq8074-nss.dtsi"
#include "ipq8074-hk-cpu.dtsi"
#include "ipq8074-ess.dtsi"
#include <dt-bindings/leds/common.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "EnGenius EWS377AP v3";
	compatible = "engenius,ews377ap-v3", "qcom,ipq8074";

	aliases {
		serial0 = &blsp1_uart5;
		led-boot = &led_blue;
		led-failsafe = &led_red;
		led-running = &led_blue;
		led-upgrade = &led_green;
	};

	chosen {
		stdout-path = "serial0,115200n8";
		bootargs-append = " root=/dev/ubiblock0_1";
	};

	keys {
		compatible = "gpio-keys";

		/* CONFIRMED (OEM hk07 DTB): reset on GPIO52, active-low */
		reset {
			label = "reset";
			gpios = <&tlmm 52 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	/*
	 * CONFIRMED (OEM hk07 DTB): single RGB status LED, active-high, on
	 * GPIO54 (R) / GPIO55 (G) / GPIO56 (B). Vendor labels: led_r/led_g/led_b.
	 */
	leds {
		compatible = "gpio-leds";

		led_red: led-red {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_RED>;
			gpios = <&tlmm 54 GPIO_ACTIVE_HIGH>;
		};

		led_green: led-green {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 55 GPIO_ACTIVE_HIGH>;
		};

		led_blue: led-blue {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&tlmm 56 GPIO_ACTIVE_HIGH>;
		};
	};
};

&blsp1_uart5 {
	status = "okay";
};

&tlmm {
	mdio_pins: mdio-pins {
		mdc {
			pins = "gpio68";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio {
			pins = "gpio69";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

&mdio {
	status = "okay";
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	/*
	 * CONFIRMED (OEM hk07 DTB): phy-reset-gpio = GPIO43 (active-high) +
	 * GPIO44 (active-low). QSDK drives both; mainline resets the bus once,
	 * so assert the primary line. TODO(validate): confirm on hardware that
	 * a single reset on GPIO43 brings all PHYs up.
	 */
	reset-gpios = <&tlmm 43 GPIO_ACTIVE_HIGH>;

	/*
	 * CONFIRMED (OEM hk07 DTB): the single external uplink PHY is a 2.5G
	 * QCA8081 at MDIO addr 0x1c (28) — ESS port 6, uniphy2, USXGMII
	 * (switch_mac_mode2 = 0x0f in the OEM DTS). This is the EWS377's PoE
	 * uplink. Use the QCA8081 phy-id compatible as the in-tree IPQ8072 2.5G
	 * APs do (e.g. ipq8071-ap8220).
	 */
	qca8081_28: ethernet-phy@28 {
		compatible = "ethernet-phy-id004d.d101";
		reg = <28>;
	};

	/*
	 * CONFIRMED (OEM hk07 DTB) but NOT wired here: the reference board also
	 * carries a QCA8075 5-port gigabit block (uniphy0, PSGMII,
	 * switch_mac_mode = 0x00) on ports 1-5 / OEM phy addr 0-4. A ceiling AP
	 * like the EWS377 almost certainly does not expose these, so they are
	 * omitted. TODO(validate on hardware): if a gigabit port IS present,
	 * add a qca8075-package node + the relevant port@1..5 with
	 * phy-mode "qsgmii" / pcs-handle <&uniphy0 N>. Note the OEM strap uses
	 * PHY base address 0-4 (mainline QCA8075 examples use 16-19) — verify
	 * the actual straps before enabling.
	 */
};

&uniphy2 {
	status = "okay";
};

&switch {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			ethernet = <&edma>;
			phy-mode = "internal";

			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};

		/*
		 * CONFIRMED (OEM hk07 DTB): 2.5G uplink = ESS port 6, phy@28,
		 * uniphy2. Labeled "lan" (AP uplink / bridge member), matching how
		 * managed APs present their single port under OpenWrt.
		 */
		swport6: port@6 {
			reg = <6>;
			label = "lan";
			phy-handle = <&qca8081_28>;
			phy-mode = "2500base-x";
			pcs-handle = <&uniphy2 0>;
		};
	};
};

&edma {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	status = "okay";

	nand@0 {
		reg = <0>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		/*
		 * OEM firmware is QSDK OpenWrt and defines the partition table in
		 * SMEM, so the layout (DEVCFG/APPSBLENV/APPSBL/cert/ART/rootfs A/B)
		 * is read automatically here — no hand-written offsets needed.
		 */
		partitions {
			compatible = "qcom,smem-part";
		};
	};
};

&wifi {
	status = "okay";
	/*
	 * CONFIRMED (OEM DTBs, both EWS377-FIT 1.1.30 and native v3.9.3.2):
	 * qcom,board_id = <0x290>. Per the OEM senaoBDF.note that board id maps
	 * to board-data blob "bdwlan.b290" (shared with ECW230v3 — same hk07
	 * board). The ipq-wifi-engenius_ews377ap-v3 board-2.bin must be built
	 * from bdwlan.b290 and keyed to whatever qmi-board-id/variant ath11k
	 * requests at first boot; set this variant string to match that entry.
	 * TODO(validate): confirm the exact ath11k board-id string from the
	 * first boot log (expected board_id 0x290).
	 */
	qcom,ath11k-calibration-variant = "EnGenius-EWS377AP-v3";
};

/*
 * LED note: the OEM also drives functional indicators (power/lan/2.4G/5G/
 * scan/ble) through the Qualcomm "qca,ledc" hardware LED controller
 * (reg 0x191e000, serial clk/data/clr on gpio18/19/20). Mainline OpenWrt has
 * NO qca,ledc driver, so those are not wired here. The user-facing RGB status
 * LED is a plain gpio-leds on GPIO54/55/56 (confirmed in both OEM DTBs) and IS
 * driven above — it produces the blue/amber/red status the unit shows.
 */
