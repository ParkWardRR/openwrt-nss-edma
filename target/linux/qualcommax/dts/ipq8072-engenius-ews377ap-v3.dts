/*
 * EnGenius EWS377AP v3  (Qualcomm IPQ8072A, board "ap-hk07")
 *
 * SCAFFOLD — derived from ipq8072-eap660hd-v1.dts (TP-Link EAP660 HD v1),
 * the closest in-tree IPQ8072 4x4 AP. Values marked TODO(extract) are
 * INHERITED PLACEHOLDERS and MUST be verified against the OEM device tree
 * pulled off real hardware (see UART/firmware extraction plan) before this
 * boots reliably. Do not treat this as validated.
 */

/dts-v1/;

#include "ipq8074.dtsi"
#include "ipq8074-nss.dtsi"
#include "ipq8074-hk-cpu.dtsi"
#include "ipq8074-ess.dtsi"
#include <dt-bindings/leds/common.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "EnGenius EWS377AP v3";
	compatible = "engenius,ews377ap-v3", "qcom,ipq8074";

	aliases {
		serial0 = &blsp1_uart5;
		led-boot = &led_status;
		led-failsafe = &led_status;
		led-running = &led_status;
		led-upgrade = &led_status;
	};

	chosen {
		stdout-path = "serial0,115200n8";
		bootargs-append = " root=/dev/ubiblock0_1";
	};

	keys {
		compatible = "gpio-keys";

		/* TODO(extract): confirm reset-button GPIO from OEM DTS */
		reset {
			label = "reset";
			gpios = <&tlmm 50 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		/*
		 * TODO(extract): EWS377AP v3 has multiple status LEDs (power +
		 * per-band). Only a single status LED is scaffolded here; map the
		 * real GPIOs/colors from the OEM DTS + /sys/class/leds.
		 */
		led_status: status {
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 42 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_BLUE>;
		};
	};
};

&blsp1_uart5 {
	status = "okay";
};

&tlmm {
	mdio_pins: mdio-pins {
		mdc {
			pins = "gpio68";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio {
			pins = "gpio69";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};
};

&mdio {
	status = "okay";
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	/* TODO(extract): confirm PHY reset GPIO */
	reset-gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;

	/*
	 * TODO(extract): EWS377AP v3 uplink is a single 2.5GbE PoE port.
	 * Confirm the PHY model + MDIO address from the OEM DTS. EAP660HD uses
	 * a QCA8081 at addr 28; the EWS377 is the same reference-design class
	 * but the address must be verified.
	 */
	qca8081_28: ethernet-phy@28 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <28>;
	};
};

&uniphy1 {
	status = "okay";
};

&switch {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			ethernet = <&edma>;
			phy-mode = "internal";

			fixed-link {
				speed = <1000>;
				full-duplex;
			};
		};

		/* TODO(extract): confirm ESS port index + link speed for the uplink */
		swport5: port@5 {
			reg = <5>;
			label = "lan";
			phy-handle = <&qca8081_28>;
			phy-mode = "2500base-x";
			pcs-handle = <&uniphy1 0>;
		};
	};
};

&edma {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	status = "okay";

	nand@0 {
		reg = <0>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		/*
		 * OEM firmware is QSDK OpenWrt and defines the partition table in
		 * SMEM, so the layout (DEVCFG/APPSBLENV/APPSBL/cert/ART/rootfs A/B)
		 * is read automatically here — no hand-written offsets needed.
		 */
		partitions {
			compatible = "qcom,smem-part";
		};
	};
};

&wifi {
	status = "okay";
	/*
	 * TODO(extract): this string must match the board-data variant inside
	 * the board-2.bin supplied by package ipq-wifi-engenius_ews377ap-v3,
	 * which itself must be built from the OEM /lib/firmware/IPQ8074 BDF.
	 */
	qcom,ath11k-calibration-variant = "EnGenius-EWS377AP-v3";
};
